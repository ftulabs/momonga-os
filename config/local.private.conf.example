# Copy this file to config/local.private.conf. Do not add the copied file to Git.
#
# Install one SSH public key for root.
CORE_IMAGE_EXTRA_INSTALL:append = " ssh-keys"
SSH_AUTHORIZED_KEY = "ssh-ed25519 AAAA... user@host"

# Optional: console-only root password for local recovery (SSH stays key-only).
# Generate the hash with: openssl passwd -6
#MOMONGA_ROOT_PASSWORD_HASH = "$6$..."
